# Telegram
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
SIGNAL_CHANNEL_ID=-1001234567890

# Admins: usernames without @, comma separated.
# Example: skillell
ADMIN_USERNAMES=skillell
# Optional persistent chat IDs. The bot also auto-registers an admin chat
# when that admin sends /start to the bot.
ADMIN_CHAT_IDS=

# NFT Tracker
TRACKER_BOT_USERNAME=fyvfhvfhyfbot

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Crypto Pay
CRYPTOBOT_API_TOKEN=YOUR_CRYPTO_PAY_API_TOKEN
CRYPTOBOT_API_BASE=https://pay.crypt.bot

# Pricing
PLAN_1_MONTH_STARS=300
PLAN_1_MONTH_USDT=5
PLAN_3_MONTHS_STARS=600
PLAN_3_MONTHS_USDT=10
PLAN_6_MONTHS_STARS=1000
PLAN_6_MONTHS_USDT=17

# App
LOG_LEVEL=INFO
CRYPTO_POLL_SECONDS=15
EXPIRY_CHECK_SECONDS=300
DEMO_FOOTER_AFTER_EACH_SIGNAL=true
